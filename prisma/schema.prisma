generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  plan        String   @default("starter")
  maxUsers    Int      @default(10)
  maxAccounts Int      @default(25)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  teams      Team[]
  clients    Client[]
  campaigns  Campaign[]
  contents   Content[]
  socialAccounts SocialAccount[]
  automations AutomationRule[]
  activities ActivityLog[]
  approvals  Approval[]
  invoices   Invoice[]
  timeEntries TimeEntry[]
  assets     Asset[]
  notifications Notification[]
  inboxMessages InboxMessage[]
  influencers Influencer[]
  brandKits  BrandKit[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  avatar         String?
  role           String   @default("member")
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  teamMemberships TeamMember[]
  contents       Content[]     @relation("ContentCreator")
  assignedContents Content[]   @relation("ContentAssignee")
  socialAccounts  SocialAccount[]
  posts           Post[]
  comments        Comment[]
  activities      ActivityLog[] @relation("ActivityActor")
  approvalsRequested Approval[] @relation("ApprovalRequester")
  approvalsReviewed  Approval[] @relation("ApprovalReviewer")
  timeEntries     TimeEntry[]  @relation("TimeEntryUser")
  assetsUploaded  Asset[]      @relation("AssetUploader")
  notifications   Notification[] @relation("NotificationUser")

  @@index([organizationId])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  type           String   // creatives, content, design, edit, archive, dissemination
  color          String   @default("#6366f1")
  icon           String?
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  members      TeamMember[]
  contents     Content[]

  @@index([organizationId])
}

model TeamMember {
  id       String @id @default(cuid())
  userId   String
  teamId   String
  role     String @default("member") // lead, member
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Client {
  id             String   @id @default(cuid())
  name           String
  logo           String?
  industry       String?
  website        String?
  email          String?
  phone          String?
  status         String   @default("active") // active, inactive, prospect
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  campaigns    Campaign[]
  invoices     Invoice[]
  timeEntries  TimeEntry[]
  assets       Asset[]
  influencers  Influencer[]
  brandKits    BrandKit[]

  @@index([organizationId])
}

model Campaign {
  id             String   @id @default(cuid())
  name           String
  description    String?
  status         String   @default("draft") // draft, active, paused, completed
  startDate      DateTime?
  endDate        DateTime?
  budget         Float?
  clientId       String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  contents     Content[]
  invoices     Invoice[]
  timeEntries  TimeEntry[]
  influencers  Influencer[]

  @@index([organizationId])
  @@index([clientId])
}

model Content {
  id             String   @id @default(cuid())
  title          String
  description    String?
  type           String   @default("post") // post, story, reel, carousel, video, graphic, article
  stage          String   @default("idea") // idea, design, edit, review, approve, disseminate, archived
  priority       String   @default("medium") // low, medium, high, urgent
  format         String?  // square, portrait, landscape, vertical
  tags           String?  // comma-separated tags
  metadata       String?  // JSON string for extra data
  dueDate        DateTime?
  publishedAt    DateTime?
  organizationId String
  campaignId     String?
  creatorId      String?
  assigneeId     String?
  teamId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  creator      User?        @relation("ContentCreator", fields: [creatorId], references: [id])
  assignee     User?        @relation("ContentAssignee", fields: [assigneeId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])
  posts        Post[]
  comments     Comment[]
  approvals    Approval[]
  timeEntries  TimeEntry[]

  @@index([organizationId])
  @@index([stage])
  @@index([campaignId])
}

model SocialAccount {
  id             String   @id @default(cuid())
  platform       String   // instagram, facebook, twitter, linkedin, tiktok, youtube, pinterest, snapchat
  accountId      String
  username       String
  displayName    String?
  avatar         String?
  accessToken    String?
  refreshToken   String?
  tokenExpiry    DateTime?
  followers      Int      @default(0)
  isVerified     Boolean  @default(false)
  isActive       Boolean  @default(true)
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
  posts          Post[]
  inboxMessages  InboxMessage[]

  @@unique([platform, accountId])
  @@index([organizationId])
  @@index([userId])
}

model Post {
  id              String    @id @default(cuid())
  content         String
  mediaUrls       String?   // comma-separated URLs
  platform        String    // instagram, facebook, twitter, etc.
  status          String    @default("draft") // draft, scheduled, publishing, published, failed
  scheduledAt     DateTime?
  publishedAt     DateTime?
  engagement      String?   // JSON string with likes, comments, shares, etc.
  failureReason   String?
  socialAccountId String
  contentId       String?
  userId          String
  organizationId  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  contentItem     Content?      @relation(fields: [contentId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  approvals       Approval[]

  @@index([organizationId])
  @@index([socialAccountId])
  @@index([status])
  @@index([scheduledAt])
}

model AutomationRule {
  id             String   @id @default(cuid())
  name           String
  description    String?
  trigger        String   // stage_change, content_created, scheduled_time, engagement_threshold
  conditions     String   // JSON string
  actions        String   // JSON string
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  contentId String
  userId    String
  createdAt DateTime @default(now())

  contentItem Content @relation(fields: [contentId], references: [id])
  user        User    @relation(fields: [userId], references: [id])

  @@index([contentId])
}

model ActivityLog {
  id             String   @id @default(cuid())
  action         String   // created, updated, moved, commented, published, assigned
  entity         String   // content, campaign, post, team, account
  entityId       String?
  details        String?  // JSON string
  organizationId String
  actorId        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
}

// ─── New Models for Enhanced ERP ──────────────────────────────────────────────

model Approval {
  id             String   @id @default(cuid())
  type           String   // content_review, post_publish, campaign_launch, budget_approval
  status         String   @default("pending") // pending, approved, rejected, changes_requested
  comment        String?
  organizationId String
  contentId      String?
  postId         String?
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  content      Content?     @relation(fields: [contentId], references: [id])
  post         Post?        @relation(fields: [postId], references: [id])
  requestedBy  User         @relation("ApprovalRequester", fields: [requestedById], references: [id])
  reviewedBy   User?        @relation("ApprovalReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([status])
}

model Invoice {
  id             String   @id @default(cuid())
  number         String   @unique
  clientId       String
  campaignId     String?
  status         String   @default("draft") // draft, sent, paid, overdue, cancelled
  items          String   // JSON array: [{description, quantity, rate, amount}]
  subtotal       Float    @default(0)
  tax            Float    @default(0)
  total          Float    @default(0)
  dueDate        DateTime?
  paidAt         DateTime?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model TimeEntry {
  id             String   @id @default(cuid())
  description    String
  hours          Float
  billable       Boolean  @default(true)
  date           DateTime
  userId         String
  clientId       String?
  campaignId     String?
  contentId      String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("TimeEntryUser", fields: [userId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  content      Content?     @relation(fields: [contentId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([clientId])
}

model Asset {
  id             String   @id @default(cuid())
  name           String
  type           String   // image, video, document, template, font, brand-guide
  url            String
  thumbnailUrl   String?
  size           Int      @default(0) // in bytes
  mimeType       String?
  tags           String?  // comma-separated
  folder         String?  // folder path
  metadata       String?  // JSON for width, height, duration, etc.
  organizationId String
  uploadedById   String
  clientId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  uploadedBy   User         @relation("AssetUploader", fields: [uploadedById], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])

  @@index([organizationId])
  @@index([type])
  @@index([folder])
}

model Notification {
  id             String   @id @default(cuid())
  title          String
  message        String
  type           String   // info, warning, success, error, approval, mention
  category       String   // content, approval, post, invoice, system
  isRead         Boolean  @default(false)
  actionUrl      String?
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("NotificationUser", fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
}

model InboxMessage {
  id             String   @id @default(cuid())
  platform       String
  senderName     String
  senderAvatar   String?
  content        String
  type           String   // comment, mention, dm, reply, review
  status         String   @default("unread") // unread, read, replied, ignored
  postUrl        String?
  socialAccountId String
  organizationId String
  repliedAt      DateTime?
  createdAt      DateTime @default(now())

  socialAccount  SocialAccount @relation(fields: [socialAccountId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([platform])
}

model Influencer {
  id               String   @id @default(cuid())
  name             String
  username         String
  platform         String
  followers        Int      @default(0)
  engagementRate   Float    @default(0)
  niche            String?  // comma-separated niches
  email            String?
  phone            String?
  notes            String?
  status           String   @default("prospect") // prospect, contacted, negotiating, active, completed, declined
  rate             Float?   // per-post rate
  contractStart    DateTime?
  contractEnd      DateTime?
  organizationId   String
  clientId         String?
  campaignId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([platform])
}

model BrandKit {
  id             String   @id @default(cuid())
  name           String
  type           String   // color, font, logo, voice, guideline
  value          String   // JSON: color hex, font family, logo url, etc.
  clientId       String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])

  @@index([organizationId])
  @@index([clientId])
}
