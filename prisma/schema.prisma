generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("starter")  // starter, professional, enterprise
  status      String   @default("active")   // active, suspended, cancelled
  domain      String?  // custom domain for the tenant
  settings    String?  // JSON string for tenant-level settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizations Organization[]
  users         User[]
  serialKeys    SerialKey[]
}

model SerialKey {
  id            String    @id @default(cuid())
  key           String    @unique
  tenantId      String
  maxDevices    Int       @default(1)
  usedDevices   Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  devices       Device[]

  @@index([tenantId])
}

model Device {
  id            String   @id @default(cuid())
  deviceId      String   @unique
  serialKeyId   String
  tenantId      String?
  organizationId String?
  userAgent     String?
  ipAddress     String?
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  serialKey     SerialKey @relation(fields: [serialKeyId], references: [id])

  @@index([serialKeyId])
  @@index([tenantId])
  @@index([organizationId])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  plan        String   @default("starter")
  maxUsers    Int      @default(10)
  maxAccounts Int      @default(25)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  users      User[]
  teams      Team[]
  clients    Client[]
  campaigns  Campaign[]
  contents   Content[]
  socialAccounts SocialAccount[]
  automations AutomationRule[]
  activities ActivityLog[]
  approvals  Approval[]
  invoices   Invoice[]
  timeEntries TimeEntry[]
  assets     Asset[]
  notifications Notification[]
  inboxMessages InboxMessage[]
  influencers Influencer[]
  brandKits  BrandKit[]
  employees  Employee[]
  attendance Attendance[]
  departments Department[]
  leaveRequests LeaveRequest[]
  payrollRuns PayrollRun[]
  jobPostings  JobPosting[]
  expenses     Expense[]
  accounts     Account[]
  taxRates     TaxRate[]
  products     Product[]
  purchaseOrders PurchaseOrder[]
  vendors      Vendor[]
  warehouses   Warehouse[]
  itAssets           ITAsset[]
  disseminators      Disseminator[]
  disseminationTasks DisseminationTask[] @relation("TaskAssigner")
  communicationTemplates CommunicationTemplate[]
  conversations     Conversation[]
  communicationMessages CommunicationMessage[]
  communicationContacts CommunicationContact[]
  journalEntries    JournalEntry[]
  invoiceItems      InvoiceItem[]

  @@index([tenantId])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  avatar         String?
  role           String   @default("member") // admin, lead, member, demo, superadmin
  password       String?
  isDemo         Boolean  @default(false)
  permissions    String?  // JSON string: {"canCreate":false,"canEdit":false,"canDelete":false}
  organizationId String
  tenantId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  tenant         Tenant?       @relation(fields: [tenantId], references: [id])
  teamMemberships TeamMember[]
  contents       Content[]     @relation("ContentCreator")
  assignedContents Content[]   @relation("ContentAssignee")
  socialAccounts  SocialAccount[]
  posts           Post[]
  comments        Comment[]
  activities      ActivityLog[] @relation("ActivityActor")
  approvalsRequested Approval[] @relation("ApprovalRequester")
  approvalsReviewed  Approval[] @relation("ApprovalReviewer")
  timeEntries     TimeEntry[]  @relation("TimeEntryUser")
  assetsUploaded  Asset[]      @relation("AssetUploader")
  notifications   Notification[] @relation("NotificationUser")
  employee        Employee?    @relation("EmployeeUser")
  expensesSubmitted Expense[] @relation("ExpenseSubmitter")
  itAssets        ITAsset[]    @relation("ITAssetAssignee")
  issuancesReceived AssetIssuance[] @relation("AssetIssuanceRecipient")
  issuancesIssued   AssetIssuance[] @relation("AssetIssuanceIssuer")
  disseminator      Disseminator?  @relation("DisseminatorUser")
  assignedTasks     DisseminationTask[] @relation("TaskAssignee")
  conversationsAssigned Conversation[] @relation("ConversationAssignee")
  messagesSent      CommunicationMessage[] @relation("MessageSender")
  journalEntriesCreated JournalEntry[] @relation("JournalEntryCreator")

  @@index([organizationId])
  @@index([tenantId])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  type           String   // creatives, content, design, edit, archive, dissemination
  color          String   @default("#6366f1")
  icon           String?
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  members      TeamMember[]
  contents     Content[]
  disseminators Disseminator[]

  @@index([organizationId])
}

model TeamMember {
  id       String @id @default(cuid())
  userId   String
  teamId   String
  role     String @default("member") // lead, member
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Client {
  id             String   @id @default(cuid())
  name           String
  logo           String?
  industry       String?
  website        String?
  email          String?
  phone          String?
  status         String   @default("active") // active, inactive, prospect
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  campaigns    Campaign[]
  invoices     Invoice[]
  timeEntries  TimeEntry[]
  assets       Asset[]
  influencers  Influencer[]
  brandKits    BrandKit[]
  disseminationTasks DisseminationTask[]
  conversations Conversation[]
  communicationContacts CommunicationContact[]

  @@index([organizationId])
}

model Campaign {
  id             String   @id @default(cuid())
  name           String
  description    String?
  status         String   @default("draft") // draft, active, paused, completed
  startDate      DateTime?
  endDate        DateTime?
  budget         Float?
  clientId       String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  contents     Content[]
  invoices     Invoice[]
  timeEntries  TimeEntry[]
  influencers  Influencer[]
  disseminationTasks DisseminationTask[]
  conversations Conversation[]

  @@index([organizationId])
  @@index([clientId])
}

model Content {
  id             String   @id @default(cuid())
  title          String
  description    String?
  type           String   @default("post") // post, story, reel, carousel, video, graphic, article
  stage          String   @default("idea") // idea, design, edit, review, approve, disseminate, archived
  priority       String   @default("medium") // low, medium, high, urgent
  format         String?  // square, portrait, landscape, vertical
  tags           String?  // comma-separated tags
  metadata       String?  // JSON string for extra data
  dueDate        DateTime?
  publishedAt    DateTime?
  organizationId String
  campaignId     String?
  creatorId      String?
  assigneeId     String?
  teamId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  creator      User?        @relation("ContentCreator", fields: [creatorId], references: [id])
  assignee     User?        @relation("ContentAssignee", fields: [assigneeId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])
  posts        Post[]
  comments     Comment[]
  approvals    Approval[]
  timeEntries  TimeEntry[]
  disseminationTasks DisseminationTask[] @relation("TaskContent")

  @@index([organizationId])
  @@index([stage])
  @@index([campaignId])
}

model SocialAccount {
  id             String   @id @default(cuid())
  platform       String   // instagram, facebook, twitter, linkedin, tiktok, youtube, pinterest, snapchat
  accountId      String
  username       String
  displayName    String?
  avatar         String?
  accessToken    String?
  refreshToken   String?
  tokenExpiry    DateTime?
  followers      Int      @default(0)
  isVerified     Boolean  @default(false)
  isActive       Boolean  @default(true)
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
  posts          Post[]
  inboxMessages  InboxMessage[]

  @@unique([platform, accountId])
  @@index([organizationId])
  @@index([userId])
}

model Post {
  id              String    @id @default(cuid())
  content         String
  mediaUrls       String?   // comma-separated URLs
  platform        String    // instagram, facebook, twitter, etc.
  status          String    @default("draft") // draft, scheduled, publishing, published, failed
  scheduledAt     DateTime?
  publishedAt     DateTime?
  engagement      String?   // JSON string with likes, comments, shares, etc.
  failureReason   String?
  socialAccountId String
  contentId       String?
  userId          String
  organizationId  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  contentItem     Content?      @relation(fields: [contentId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  approvals       Approval[]

  @@index([organizationId])
  @@index([socialAccountId])
  @@index([status])
  @@index([scheduledAt])
}

model AutomationRule {
  id             String   @id @default(cuid())
  name           String
  description    String?
  trigger        String   // stage_change, content_created, scheduled_time, engagement_threshold
  conditions     String   // JSON string
  actions        String   // JSON string
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  contentId String
  userId    String
  createdAt DateTime @default(now())

  contentItem Content @relation(fields: [contentId], references: [id])
  user        User    @relation(fields: [userId], references: [id])

  @@index([contentId])
}

model ActivityLog {
  id             String   @id @default(cuid())
  action         String   // created, updated, moved, commented, published, assigned
  entity         String   // content, campaign, post, team, account
  entityId       String?
  details        String?  // JSON string
  organizationId String
  actorId        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
}

// ─── New Models for Enhanced ERP ──────────────────────────────────────────────

model Approval {
  id             String   @id @default(cuid())
  type           String   // content_review, post_publish, campaign_launch, budget_approval
  status         String   @default("pending") // pending, approved, rejected, changes_requested
  comment        String?
  organizationId String
  contentId      String?
  postId         String?
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  content      Content?     @relation(fields: [contentId], references: [id])
  post         Post?        @relation(fields: [postId], references: [id])
  requestedBy  User         @relation("ApprovalRequester", fields: [requestedById], references: [id])
  reviewedBy   User?        @relation("ApprovalReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([status])
}

model Invoice {
  id             String   @id @default(cuid())
  number         String   @unique
  clientId       String
  campaignId     String?
  status         String   @default("draft") // draft, sent, paid, overdue, cancelled
  subtotal       Float    @default(0)
  tax            Float    @default(0)
  total          Float    @default(0)
  dueDate        DateTime?
  paidAt         DateTime?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  rate        Float    @default(0)
  amount      Float    @default(0)
  organizationId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([invoiceId])
  @@index([organizationId])
}

model TimeEntry {
  id             String   @id @default(cuid())
  description    String
  hours          Float
  billable       Boolean  @default(true)
  date           DateTime
  userId         String
  clientId       String?
  campaignId     String?
  contentId      String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("TimeEntryUser", fields: [userId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  content      Content?     @relation(fields: [contentId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([clientId])
}

model Asset {
  id             String   @id @default(cuid())
  name           String
  type           String   // image, video, document, template, font, brand-guide
  url            String
  thumbnailUrl   String?
  size           Int      @default(0) // in bytes
  mimeType       String?
  tags           String?  // comma-separated
  folder         String?  // folder path
  metadata       String?  // JSON for width, height, duration, etc.
  organizationId String
  uploadedById   String
  clientId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  uploadedBy   User         @relation("AssetUploader", fields: [uploadedById], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])

  @@index([organizationId])
  @@index([type])
  @@index([folder])
}

model Notification {
  id             String   @id @default(cuid())
  title          String
  message        String
  type           String   // info, warning, success, error, approval, mention
  category       String   // content, approval, post, invoice, system
  isRead         Boolean  @default(false)
  actionUrl      String?
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("NotificationUser", fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
}

model InboxMessage {
  id             String   @id @default(cuid())
  platform       String
  senderName     String
  senderAvatar   String?
  content        String
  type           String   // comment, mention, dm, reply, review
  status         String   @default("unread") // unread, read, replied, ignored
  postUrl        String?
  socialAccountId String
  organizationId String
  repliedAt      DateTime?
  createdAt      DateTime @default(now())

  socialAccount  SocialAccount @relation(fields: [socialAccountId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([platform])
}

model Influencer {
  id               String   @id @default(cuid())
  name             String
  username         String
  platform         String
  followers        Int      @default(0)
  engagementRate   Float    @default(0)
  niche            String?  // comma-separated niches
  email            String?
  phone            String?
  notes            String?
  status           String   @default("prospect") // prospect, contacted, negotiating, active, completed, declined
  rate             Float?   // per-post rate
  contractStart    DateTime?
  contractEnd      DateTime?
  organizationId   String
  clientId         String?
  campaignId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  conversations Conversation[]
  communicationContacts CommunicationContact[]

  @@index([organizationId])
  @@index([status])
  @@index([platform])
}

model BrandKit {
  id             String   @id @default(cuid())
  name           String
  type           String   // color, font, logo, voice, guideline
  value          String   // JSON: color hex, font family, logo url, etc.
  clientId       String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])

  @@index([organizationId])
  @@index([clientId])
}

// ─── HR Module ──────────────────────────────────────────────────────────────────

model Department {
  id             String   @id @default(cuid())
  name           String
  description    String?
  color          String   @default("#10b981")
  headId         String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  jobPostings  JobPosting[]

  @@index([organizationId])
}

model Employee {
  id             String   @id @default(cuid())
  userId         String?
  employeeId     String
  firstName      String
  lastName       String
  email          String
  phone          String?
  avatar         String?
  position       String
  departmentId   String
  hireDate       DateTime
  status         String   @default("active")
  employmentType String   @default("full-time")
  salary         Float?
  salaryCurrency String   @default("USD")
  bankAccount    String?
  taxId          String?
  emergencyContact String?
  address        String?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department  @relation(fields: [departmentId], references: [id])
  leaveRequests LeaveRequest[]
  payrollItems  PayrollItem[]
  user          User?       @relation("EmployeeUser", fields: [userId], references: [id])
  attendance    Attendance[]

  @@unique([userId])

  @@index([organizationId])
  @@index([departmentId])
  @@index([status])
}

model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  date          DateTime
  clockIn       DateTime?
  clockOut      DateTime?
  status        String   @default("present") // present, absent, late, half-day, leave
  workHours     Float?
  notes         String?
  organizationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id])

  @@index([employeeId])
  @@index([organizationId])
  @@index([date])
}

model LeaveRequest {
  id             String   @id @default(cuid())
  employeeId     String
  type           String
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String?
  status         String   @default("pending")
  approvedById   String?
  approvedAt     DateTime?
  comment        String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
}

model PayrollRun {
  id             String   @id @default(cuid())
  period         String
  status         String   @default("draft")
  runDate        DateTime
  totalGross     Float    @default(0)
  totalDeductions Float   @default(0)
  totalNet       Float    @default(0)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  items        PayrollItem[]

  @@index([organizationId])
  @@index([period])
}

model PayrollItem {
  id             String   @id @default(cuid())
  payrollRunId   String
  employeeId     String
  baseSalary     Float    @default(0)
  overtime       Float    @default(0)
  bonuses        Float    @default(0)
  deductions     Float    @default(0)
  tax            Float    @default(0)
  netPay         Float    @default(0)
  organizationId String
  createdAt      DateTime @default(now())

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@index([payrollRunId])
  @@index([employeeId])
}

model JobPosting {
  id             String   @id @default(cuid())
  title          String
  departmentId   String
  type           String   @default("full-time")
  location       String?
  salary_min     Float?
  salary_max     Float?
  description    String
  requirements   String?
  status         String   @default("open")
  postedDate     DateTime?
  closingDate    DateTime?
  applicants     Int      @default(0)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department  @relation(fields: [departmentId], references: [id])

  @@index([organizationId])
  @@index([status])
}

// ─── Finance Module ────────────────────────────────────────────────────────────

model Expense {
  id             String   @id @default(cuid())
  title          String
  description    String?
  amount         Float
  category       String
  date           DateTime
  status         String   @default("pending")
  receiptUrl     String?
  submittedById  String
  approvedById   String?
  approvedAt     DateTime?
  campaignId     String?
  clientId       String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  submittedBy  User         @relation("ExpenseSubmitter", fields: [submittedById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([category])
}

model Account {
  id             String   @id @default(cuid())
  code           String
  name           String
  type           String          // asset, liability, equity, revenue, expense
  category       String?
  description    String?
  normalBalance  String   @default("debit") // debit or credit
  parentId       String?
  balance        Float    @default(0)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id])
  parent         Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]      @relation("AccountHierarchy")
  journalLines   JournalEntryLine[]

  @@index([organizationId])
  @@index([type])
  @@index([parentId])
  @@index([code])
}

model TaxRate {
  id             String   @id @default(cuid())
  name           String
  rate           Float
  type           String
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ─── Inventory Module ──────────────────────────────────────────────────────────

model Product {
  id             String   @id @default(cuid())
  name           String
  sku            String
  description    String?
  category       String?
  unit           String   @default("pcs")
  unitPrice      Float    @default(0)
  costPrice      Float    @default(0)
  reorderLevel   Int      @default(10)
  imageUrl       String?
  tags           String?
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  poItems        PurchaseOrderItem[]

  @@index([organizationId])
  @@index([sku])
  @@index([category])
}

model StockLevel {
  id             String @id @default(cuid())
  productId      String
  warehouseId    String
  quantity       Int    @default(0)
  reservedQuantity Int  @default(0)
  organizationId String

  product    Product   @relation(fields: [productId], references: [id])
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([organizationId])
}

model Warehouse {
  id             String   @id @default(cuid())
  name           String
  code           String
  location       String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  stockLevels  StockLevel[]
  stockMovements StockMovement[]

  @@index([organizationId])
}

model StockMovement {
  id             String   @id @default(cuid())
  productId      String
  warehouseId    String
  type           String
  quantity       Int
  reference      String?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model Vendor {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  address        String?
  category       String?
  rating         Float    @default(0)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  number         String
  vendorId       String
  status         String   @default("draft")
  items          String
  subtotal       Float    @default(0)
  tax            Float    @default(0)
  total          Float    @default(0)
  orderDate      DateTime
  expectedDate   DateTime?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  poItems      PurchaseOrderItem[]

  @@index([organizationId])
  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Float
  total           Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

// ─── IT Asset Management ───────────────────────────────────────────────────────

model ITAsset {
  id              String   @id @default(cuid())
  assetTag        String   @unique  // e.g. "IT-LAP-001", "IT-KEY-042"
  name            String   // e.g. "MacBook Pro 14 inch", "Logitech MX Master 3S"
  category        String   // laptop, desktop, monitor, keyboard, mouse, headphone, usb, webcam, dock, cable, adapter, tablet, phone, printer, router, other
  brand           String?  // Apple, Dell, Logitech, etc.
  model           String?  // "MacBook Pro 14 M3", "MX Master 3S"
  serialNumber    String?
  specifications  String?  // JSON: { ram, storage, cpu, screen_size, color, etc. }
  purchaseDate    DateTime?
  purchaseCost    Float?
  warrantyExpiry  DateTime?
  vendor          String?
  invoiceNumber   String?
  condition       String   @default("new") // new, good, fair, damaged, retired
  status          String   @default("available") // available, issued, maintenance, retired, lost
  assignedToId    String?  // userId currently holding the asset
  location        String?  // "Office A", "Remote", "Store Room"
  notes           String?
  imageUrl        String?
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id])
  assignedTo      User?         @relation("ITAssetAssignee", fields: [assignedToId], references: [id])
  issuances       AssetIssuance[]

  @@index([organizationId])
  @@index([category])
  @@index([status])
  @@index([assignedToId])
}

model AssetIssuance {
  id              String   @id @default(cuid())
  assetId         String
  issuedToId      String   // userId receiving the asset
  issuedById      String   // userId (IT admin) issuing the asset
  issueDate       DateTime @default(now())
  expectedReturnDate DateTime?
  actualReturnDate DateTime?
  returnCondition String?  // condition when returned
  issueCondition  String?  // condition when issued
  purpose         String?  // "Daily work", "Project X", "Remote work"
  notes           String?
  status          String   @default("issued") // issued, returned, overdue, lost
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset           ITAsset  @relation(fields: [assetId], references: [id])
  issuedTo        User     @relation("AssetIssuanceRecipient", fields: [issuedToId], references: [id])
  issuedBy        User     @relation("AssetIssuanceIssuer", fields: [issuedById], references: [id])

  @@index([organizationId])
  @@index([assetId])
  @@index([issuedToId])
  @@index([status])
}

// ─── Dissemination Module ─────────────────────────────────────────────────────

model Disseminator {
  id              String   @id @default(cuid())
  userId          String
  teamId          String?  // link to the dissemination team
  speciality      String?  // e.g. "Instagram Reels", "LinkedIn Articles", "Multi-platform"
  platforms       String?  // JSON array of platforms this disseminator handles: ["instagram","facebook"]
  workloadCapacity Int     @default(10) // max concurrent tasks
  status          String   @default("active") // active, on_leave, inactive
  rating          Float    @default(0) // performance rating 0-5
  totalTasksCompleted Int  @default(0)
  totalPostsPublished Int  @default(0)
  avgCompletionHours Float  @default(0) // average time to complete a task
  onTimeRate      Float    @default(0) // percentage of tasks completed on time (0-100)
  notes           String?
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  user            User         @relation("DisseminatorUser", fields: [userId], references: [id])
  team            Team?        @relation(fields: [teamId], references: [id])
  assignedTasks   DisseminationTask[] @relation("TaskDisseminator")

  @@unique([userId])
  @@index([organizationId])
  @@index([status])
}

model DisseminationTask {
  id              String   @id @default(cuid())
  title           String
  description     String?
  contentId       String?  // link to the approved content piece
  assigneeId      String?  // disseminator user id (who will post)
  disseminatorId  String?  // link to disseminator profile
  clientId        String?  // which client this is for
  campaignId      String?  // which campaign
  targetPlatforms String?  // JSON array: ["instagram","facebook","twitter"]
  postContent     String?  // the actual content/caption to post
  mediaUrls       String?  // JSON array of media URLs
  hashtags        String?  // comma-separated hashtags
  scheduledAt     DateTime? // when to post
  dueDate         DateTime? // deadline for completion
  priority        String   @default("medium") // low, medium, high, urgent
  status          String   @default("pending") // pending, in_progress, completed, failed, overdue, cancelled
  startedAt       DateTime?
  completedAt     DateTime?
  postId          String?  // link to the created post once published
  failureReason   String?
  assignedById    String?  // who assigned this task
  assignedAt      DateTime?
  completionNotes String?
  engagement      String?  // JSON: engagement data pulled after publishing
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation("TaskAssigner", fields: [organizationId], references: [id])
  content         Content?     @relation("TaskContent", fields: [contentId], references: [id])
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  disseminator    Disseminator? @relation("TaskDisseminator", fields: [disseminatorId], references: [id])
  client          Client?      @relation(fields: [clientId], references: [id])
  campaign        Campaign?    @relation(fields: [campaignId], references: [id])

  @@index([organizationId])
  @@index([assigneeId])
  @@index([disseminatorId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([scheduledAt])
}

// ─── Communication Module ───────────────────────────────────────────────────

model CommunicationTemplate {
  id              String   @id @default(cuid())
  name            String
  subject         String?  // for email
  body            String
  type            String   @default("email") // email, whatsapp, sms
  category        String?  // welcome, follow_up, proposal, invoice, reminder, campaign, notification
  variables       String?  // JSON array of template variables: ["name", "company", "date"]
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  messages        CommunicationMessage[]

  @@index([organizationId])
  @@index([type])
}

model Conversation {
  id              String   @id @default(cuid())
  subject         String?
  type            String   @default("email") // email, whatsapp, mixed
  status          String   @default("active") // active, archived, closed
  priority        String   @default("normal") // low, normal, high, urgent
  channel         String   @default("email") // email, whatsapp, manual
  clientId        String?
  influencerId    String?
  campaignId      String?
  assignedToId    String?  // userId assigned to this conversation
  lastMessageAt   DateTime @default(now())
  lastMessagePreview String? // preview of last message
  unreadCount     Int      @default(0)
  tags            String?  // comma-separated tags
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  client          Client?      @relation(fields: [clientId], references: [id])
  influencer      Influencer?  @relation(fields: [influencerId], references: [id])
  campaign        Campaign?    @relation(fields: [campaignId], references: [id])
  assignedTo      User?        @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  messages        CommunicationMessage[]

  @@index([organizationId])
  @@index([clientId])
  @@index([influencerId])
  @@index([assignedToId])
  @@index([status])
  @@index([lastMessageAt])
}

model CommunicationMessage {
  id                String   @id @default(cuid())
  conversationId    String
  senderId          String?  // userId (null for external contacts)
  senderName        String
  senderEmail       String?  // email of sender
  senderPhone       String?  // phone of sender
  recipientName     String
  recipientEmail    String?  // for email
  recipientPhone    String?  // for whatsapp
  subject           String?  // for email
  body              String
  htmlBody          String?  // rich HTML for email
  mediaUrls         String?  // JSON array of attachment URLs
  type              String   @default("email") // email, whatsapp, note
  direction         String   @default("outbound") // inbound, outbound
  status            String   @default("sent") // draft, queued, sent, delivered, read, failed, bounced
  failureReason     String?
  templateId        String?
  isStarred         Boolean  @default(false)
  isRead            Boolean  @default(true)
  readAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime? // email open tracking
  clickedAt         DateTime? // link click tracking
  repliedAt         DateTime?
  externalId        String?  // external message ID from provider
  organizationId    String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversation      Conversation @relation(fields: [conversationId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])
  sender            User?        @relation("MessageSender", fields: [senderId], references: [id])
  template          CommunicationTemplate? @relation(fields: [templateId], references: [id])

  @@index([conversationId])
  @@index([organizationId])
  @@index([senderId])
  @@index([status])
  @@index([createdAt])
}

model CommunicationContact {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  whatsappNumber  String?
  company         String?
  role            String?  // client, influencer, partner, vendor
  avatar          String?
  notes           String?
  preferredChannel String  @default("email") // email, whatsapp
  lastContactedAt  DateTime?
  isFavorite      Boolean  @default(false)
  tags            String?
  clientId        String?
  influencerId    String?
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  client          Client?      @relation(fields: [clientId], references: [id])
  influencer      Influencer?  @relation(fields: [influencerId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model JournalEntry {
  id             String   @id @default(cuid())
  number         String   @unique
  date           DateTime
  description    String
  reference      String?   // e.g. INV-001, PAY-042
  source         String    // manual, invoice, expense, payroll, transfer
  sourceId       String?   // ID of the source document
  status         String    @default("draft") // draft, posted, void
  isAdjusting    Boolean   @default(false)
  period         String    // e.g. "2026-01" for fiscal period
  totalDebit     Float     @default(0)
  totalCredit    Float     @default(0)
  organizationId String
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  createdBy      User?        @relation("JournalEntryCreator", fields: [createdById], references: [id])
  lines          JournalEntryLine[]

  @@index([organizationId])
  @@index([date])
  @@index([status])
  @@index([period])
  @@index([source])
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float    @default(0)
  credit         Float    @default(0)
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([organizationId])
}
